# Dermahealth environment configuration (template - safe to commit).
#
# Setup:  cp .env.example .env   then restart Metro: pnpm start --reset-cache
#
# EVERY value below is compiled into the JavaScript bundle, so it is PUBLIC.
# Never put private keys, keystores, certificates, service-account files or
# server-side secrets in any env file. Only variables listed here (all APP_*)
# are exposed to the app.

# --- Build environment (required) -------------------------------------------
# One of: development, staging, production
APP_ENV=development

# --- Logging (required) -----------------------------------------------------
# One of: debug, info, warn, error. Health data is redacted at every level.
APP_LOG_LEVEL=warn

# --- Backend API (required) -------------------------------------------------
# Domain every API call goes through (no trailing slash). Paths live in
# src/configs/urls.ts.
APP_API_BASE_URL=https://dermahealth.fitdnu.id.vn
# Request timeout in milliseconds (optional, built-in default: 15000).
APP_API_TIMEOUT_MS=15000

# --- Simulated demo account (optional) --------------------------------------
# Public demo credentials for the SIMULATED sign-in; they unlock nothing real.
# Set both or neither. When both are set the sign-in screen shows them as a
# hint. They must not be set when APP_ENV=production, and must never be a
# real password.
APP_DEMO_ACCOUNT_EMAIL=demo@dermahealth.vn
APP_DEMO_ACCOUNT_PASSWORD=Demo@1234

# --- Simulation timing in milliseconds (optional) ---------------------------
# Delay of simulated sign-in and password reset (built-in default: 500).
APP_SIMULATION_LATENCY_MS=500
# Duration of the simulated skin assessment (built-in default: 2400).
APP_ASSESSMENT_DURATION_MS=2400
# Interval of the queue "auto run" simulation (built-in default: 4000).
APP_QUEUE_AUTO_STEP_MS=4000
