{
  "name": "Dermahealth",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.js\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.js\"",
    "bundle": "pnpm env:check && npm run bundle:ios && npm run bundle:android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/dermahealth.ios.jsbundle",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/dermahealth.android.jsbundle",
    "verify:platforms": "node scripts/verify-platform-resolution.js",
    "env:check": "node scripts/env/check-env.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "lucide-react-native": "1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
